<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fly2" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/fly2_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/fly2_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/fly2_green</item>
        <item name="android:windowSplashScreenBackground">@color/fly2_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fly2</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/fly2_green</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
